<!-- include('partials/header') -->

<section class="featured">
    <div style="
    max-width: 600px;
    margin: 0 auto;
    background: white;
    padding: 2.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    ">
    <h2 style="margin-bottom: 1.5rem; text-align: center;">
    Bæta við nýrri uppskrift
    </h2>
    <form action="/uppskriftir/ny" method="POST" style="
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    ">
    <div>
    <label for="title" style="
    font-weight: 600;
    display: block;
    margin-bottom: 0.5rem;
    ">Nafn uppskriftar *</label>
    </div>
    <input type="text"
    id="title"
    name="title"
    required
    >
    </div>

<div>
    <label for="time_minutes">
    Eldunartimi (i minútum)
    </label>
    <input
    type="number"
    id="time_minutes"
    name="time_minutes"
    placeholder="T.d. 45"
    >
</div>

<div>
    <label for="image_url">
    Slóð á mynd (valfrjálst)
    </label>
    <input
    type="text"
    id="image_url"
    name="image_url"
    placeholder="https://..."
    >
</div>

<button type="submit" class="btn-primary">
    Vista uppskrift
</button>
</form>
</div>
</section>

% - include('partials/footer') %