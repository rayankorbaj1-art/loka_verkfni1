<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitFlow AI - Personal Trainer</title>
    <link rel="stylesheet" href="/scss/main.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <div class="app-container">
        <div class="tagline">Your intelligent personal trainer — science-backed plans, built for real life.</div>
        
        <div class="card" id="questionnaireCard">
            <h3>✨ Let's craft your custom plan</h3>
            <div class="form-grid">
                <div class="input-group">
                    <label>🎯 What's your main goal?</label>
                    <select id="goalSelect">
                        <option value="weightLoss">Weight Loss (fat burn)</option>
                        <option value="muscleGain">Muscle Gain (hypertrophy)</option>
                        <option value="generalFitness">General Fitness (health)</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>📊 Current fitness level</label>
                    <select id="levelSelect">
                        <option value="beginner">Beginner</option>
                        <option value="intermediate">Intermediate</option>
                        <option value="advanced">Advanced</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>📅 Days per week you can exercise</label>
                    <select id="daysSelect">
                        <option value="2">2 days</option>
                        <option value="3" selected>3 days</option>
                        <option value="4">4 days</option>
                        <option value="5">5 days</option>
                    </select>
                </div>
                <button class="btn-primary" id="generateBtn">🚀 Generate my personalized plan →</button>
            </div>
        </div>
        
        <div id="planSection" style="display:none;">
            <div class="card">
                <div class="plan-header">
                    <h2>📋 Your weekly blueprint</h2>
                    <button id="resetBtn" class="reset-link">⟳ Start over</button>
                </div>
                <div id="planContainer"></div>
                <div class="progress-area">
                    <div id="motivationMessage"></div>
                    <button id="logWorkoutBtn" class="motivation-message">✔️ Log today's workout</button>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('partials/footer') %>
    <script src="/js/fitness.js"></script>
</body>
</html>