<%- include('partials/header') %>
  <h1>All Exercises</h1>
  <div class="exercises-grid">
    <% exercises.forEach(exercise => { %>
      <div class="exercise-card">
        <h3><%= exercise.name %></h3>
        <p><%= exercise.difficulty %> • <%= exercise.duration %></p>
        <a href="/exercise/<%= exercise.id %>" class="btn">View</a>
      </div>
    <% }) %>
  </div>
<%- include('partials/footer') %>